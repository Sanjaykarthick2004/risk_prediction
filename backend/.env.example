MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=explainable_injury_ai

SECRET_KEY=CHANGE_THIS_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

MODEL_PATH=./models/xgboost_model.pkl
PREPROCESSING_PATH=./models/preprocessing_pipeline.pkl
FEATURE_COLUMNS_PATH=./models/feature_columns.pkl
SHAP_PATH=./models/shap_explainer.pkl

CORS_ORIGINS=http://localhost:5173

# Size of the bundled SYNTHETIC DEMONSTRATION DATA (running athletes) regenerated the first
# time training runs if backend/data/raw/athlete_data.csv doesn't exist. 5,000-10,000 is the
# intended academic range for a normal college laptop; avoid 100,000+ without a reason.
SYNTHETIC_DATASET_SIZE=10000

# Used to build email-verification / password-reset links. No real email is sent for this
# project (see app/services/email_service.py) — links are logged and returned in the API
# response instead, so this just needs to match wherever the frontend actually runs.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
